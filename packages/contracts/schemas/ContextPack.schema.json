{
  "$defs": {
    "EvidenceChunk": {
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "token_count": {
          "title": "Token Count",
          "type": "integer"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "locator": {
          "additionalProperties": true,
          "title": "Locator",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "version_id",
        "workspace_id",
        "content",
        "token_count"
      ],
      "title": "EvidenceChunk",
      "type": "object"
    },
    "MemoryImpact": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "MemoryImpact",
      "type": "string"
    },
    "MemoryRecord": {
      "properties": {
        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "memory_type": {
          "$ref": "#/$defs/MemoryType"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "confidence": {
          "default": 1.0,
          "title": "Confidence",
          "type": "number"
        },
        "impact": {
          "$ref": "#/$defs/MemoryImpact",
          "default": "medium"
        },
        "source_document_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Document Ids",
          "type": "array"
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "is_active": {
          "default": true,
          "title": "Is Active",
          "type": "boolean"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "memory_id",
        "workspace_id",
        "memory_type",
        "title",
        "content"
      ],
      "title": "MemoryRecord",
      "type": "object"
    },
    "MemoryType": {
      "enum": [
        "fact",
        "decision",
        "preference",
        "workflow"
      ],
      "title": "MemoryType",
      "type": "string"
    }
  },
  "properties": {
    "context_pack_id": {
      "title": "Context Pack Id",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "evidence_chunks": {
      "items": {
        "$ref": "#/$defs/EvidenceChunk"
      },
      "title": "Evidence Chunks",
      "type": "array"
    },
    "memories": {
      "items": {
        "$ref": "#/$defs/MemoryRecord"
      },
      "title": "Memories",
      "type": "array"
    },
    "token_budget": {
      "default": 4096,
      "title": "Token Budget",
      "type": "integer"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "context_pack_id",
    "workspace_id",
    "query"
  ],
  "title": "ContextPack",
  "type": "object"
}