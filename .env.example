# ==============================================================================
# RekanVault Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & App Core
# ------------------------------------------------------------------------------
RV_ENV=development                            # development | test | staging | production
RV_LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR | CRITICAL
RV_LOG_FORMAT=console                         # console (for local CLI/dev) or json
RV_PUBLIC_BASE_URL=http://localhost:3000      # Canonical Web application origin
RV_API_BASE_URL=http://localhost:8000         # Canonical API application origin
RV_ALLOWED_ORIGINS=http://localhost:3000      # Comma-separated CORS allowed browser origins
RV_RELEASE_VERSION=0.1.0                      # Product release version tag
RV_COMPONENT_INSTANCE=api-1                   # Instance identifier for metrics & logging
RV_API_HOST=0.0.0.0                           # API server bind host
RV_API_PORT=8000                              # API server bind port
RV_REQUEST_MAX_BODY_BYTES=10485760            # Maximum HTTP request body size (10MB)
RV_SHUTDOWN_GRACE_SECONDS=30                  # Worker/API graceful shutdown timeout

# ------------------------------------------------------------------------------
# 2. Phase 2: PostgreSQL, Identity & Auth (Supabase)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string for SQLAlchemy async pool
RV_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rekanvault
RV_DATABASE_POOL_MIN_SIZE=1
RV_DATABASE_POOL_MAX_SIZE=10
RV_DATABASE_STATEMENT_TIMEOUT_MS=30000

# Supabase Auth & JWT Verification Settings
RV_SUPABASE_URL=http://localhost:54321
RV_SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/jwks.json
RV_SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
RV_SUPABASE_JWT_AUDIENCE=authenticated

# SECURITY INVARIANT (Risk R-003):
# RV_SUPABASE_SECRET_KEY bypasses Row Level Security (RLS).
# It MUST ONLY be used in Alembic migration scripts and background worker admin routines.
# NEVER expose this key to public API handlers, frontend packages, or browser bundles.
RV_SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. Phase 2: AES-GCM Envelope Encryption (Credentials)
# ------------------------------------------------------------------------------
# Formatted as key_id:base64key (multiple keys separated by comma for key rotation)
# Example: key-1:b3BlbnNzaC1rZXktdjEAAAABGm5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMw...
RV_CREDENTIAL_ENCRYPTION_KEYS=key-1:dGVzdF9rZXlfMzJfYnl0ZXNfYmFzZTY0X2VuY29kZWRfMQ==
RV_ACTIVE_CREDENTIAL_KEY_ID=key-1

# ------------------------------------------------------------------------------
# 4. Phase 2: Durable Worker & Artifact Storage
# ------------------------------------------------------------------------------
RV_WORKER_QUEUES=default
RV_WORKER_CONCURRENCY=2
RV_JOB_POLL_INTERVAL_MS=1000
RV_JOB_LEASE_SECONDS=300
RV_JOB_MAX_ATTEMPTS=8
RV_ARTIFACT_STORAGE_BACKEND=filesystem
RV_ARTIFACT_STORAGE_PATH=/tmp/rekanvault_artifacts
RV_MAX_SOURCE_FILE_BYTES=52428800

# ------------------------------------------------------------------------------
# 5. Next.js Web Frontend (Public / Client-Exposed)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_REKANVAULT_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. Connectors (Phase 3 Placeholders)
# ------------------------------------------------------------------------------
RV_GOOGLE_CLIENT_ID=
RV_GOOGLE_CLIENT_SECRET=
RV_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback/google
RV_GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly

RV_NOTION_API_VERSION=2026-03-11
RV_NOTION_WEBHOOK_VERIFICATION_TOKEN=
