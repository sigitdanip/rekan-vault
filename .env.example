# ==============================================================================
# RekanVault Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in your Public IP / Hostname and external service keys.
#    NOTE: Do NOT use 'localhost' for Supabase or API URLs if clients access the
#    app over a network — use your server's Public IP or domain name instead.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Server Core
# ------------------------------------------------------------------------------
RV_ENV=development                            # development | test | staging | production
RV_LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR | CRITICAL
RV_LOG_FORMAT=console                         # console or json

# Public network origins (Use Server Public IP or Domain, e.g. http://1.2.3.4:3000)
RV_PUBLIC_BASE_URL=http://<SERVER_PUBLIC_IP>:3000
RV_API_BASE_URL=http://<SERVER_PUBLIC_IP>:8000
RV_ALLOWED_ORIGINS=http://<SERVER_PUBLIC_IP>:3000

RV_RELEASE_VERSION=0.1.0                      # Product release version tag
RV_COMPONENT_INSTANCE=api-1                   # Instance label
RV_API_HOST=0.0.0.0                           # API bind host
RV_API_PORT=8000                              # API bind port
RV_REQUEST_MAX_BODY_BYTES=10485760            # Max HTTP request body (10MB)
RV_SHUTDOWN_GRACE_SECONDS=30                  # Shutdown timeout

# ------------------------------------------------------------------------------
# 2. Supabase Database & Auth (Public IP / Domain or Supabase Cloud)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URI (e.g. postgresql+psycopg://postgres:<PASSWORD>@<SERVER_PUBLIC_IP>:5432/rekanvault)
RV_DATABASE_URL=
RV_DATABASE_POOL_MIN_SIZE=1
RV_DATABASE_POOL_MAX_SIZE=10
RV_DATABASE_STATEMENT_TIMEOUT_MS=30000

# Supabase Public Endpoints (Use Public IP / Domain, e.g. http://<SERVER_PUBLIC_IP>:54321 or https://<project-ref>.supabase.co)
RV_SUPABASE_URL=
RV_SUPABASE_JWKS_URL=
RV_SUPABASE_JWT_ISSUER=
RV_SUPABASE_JWT_AUDIENCE=authenticated

# SECURITY INVARIANT (Risk R-003, RV-DEC-P2-0003):
# Used ONLY in Alembic migrations and admin background jobs. NEVER expose to browser/API.
RV_SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. Credential Encryption Keys (RV-DEC-P2-0004)
# ------------------------------------------------------------------------------
# Format: key_id:base64key (32-byte key base64 encoded)
# Generate with: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
RV_ACTIVE_CREDENTIAL_KEY_ID=key-1
RV_CREDENTIAL_ENCRYPTION_KEYS=

# ------------------------------------------------------------------------------
# 4. Job Engine & Artifact Storage (RV-DEC-P2-0005, RV-DEC-P2-0006)
# ------------------------------------------------------------------------------
RV_WORKER_QUEUES=default
RV_WORKER_CONCURRENCY=2
RV_JOB_POLL_INTERVAL_MS=1000
RV_JOB_LEASE_SECONDS=300
RV_JOB_MAX_ATTEMPTS=8

# Local VPS filesystem artifact storage (RV-DEC-P2-0006)
RV_ARTIFACT_STORAGE_BACKEND=filesystem
RV_ARTIFACT_STORAGE_PATH=/tmp/rekanvault_artifacts
RV_MAX_SOURCE_FILE_BYTES=52428800

# ------------------------------------------------------------------------------
# 5. Next.js Web Frontend (Public Browser Accessible URLs)
# ------------------------------------------------------------------------------
# Must be accessible by end-user browsers (e.g. http://<SERVER_PUBLIC_IP>:54321 or https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_REKANVAULT_API_URL=http://<SERVER_PUBLIC_IP>:8000

# ------------------------------------------------------------------------------
# 6. Qdrant Cloud Vector Index (Phase 4 - User Fills From Qdrant Dashboard)
# ------------------------------------------------------------------------------
# Example: https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
RV_QDRANT_URL=
RV_QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 7. Source Connectors (Phase 3 Placeholders)
# ------------------------------------------------------------------------------
RV_GOOGLE_CLIENT_ID=
RV_GOOGLE_CLIENT_SECRET=
RV_GOOGLE_OAUTH_REDIRECT_URI=http://<SERVER_PUBLIC_IP>:8000/api/v1/auth/callback/google
RV_GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly

RV_NOTION_API_VERSION=2026-03-11
RV_NOTION_TOKEN=
RV_NOTION_WEBHOOK_VERIFICATION_TOKEN=
