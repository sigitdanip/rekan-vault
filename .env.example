# ==============================================================================
# RekanVault Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Server Core
# ------------------------------------------------------------------------------
RV_ENV=development
RV_API_BASE_URL=http://localhost:9002
RV_ALLOWED_ORIGINS=http://localhost:9001
RV_RELEASE_VERSION=0.1.0
RV_COMPONENT_INSTANCE=api-1
RV_API_HOST=0.0.0.0
RV_API_PORT=9002
RV_SHUTDOWN_GRACE_SECONDS=30

# ------------------------------------------------------------------------------
# 2. Supabase Database & Auth (RV-DEC-P2-0001, RV-DEC-P2-0002)
# ------------------------------------------------------------------------------
RV_DATABASE_URL=
RV_DATABASE_POOL_MIN_SIZE=1
RV_DATABASE_POOL_MAX_SIZE=10

# Supabase Auth Endpoints
RV_SUPABASE_JWT_ISSUER=
RV_SUPABASE_JWT_AUDIENCE=authenticated

# SECURITY INVARIANT (Risk R-003, RV-DEC-P2-0003):
# Used ONLY in Alembic migrations and admin background jobs. NEVER expose to browser/API.
RV_SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. Credential Encryption Keys (RV-DEC-P2-0004)
# ------------------------------------------------------------------------------
RV_CREDENTIAL_KEY_ACTIVE=key-1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RV_CREDENTIAL_KEY_PREVIOUS=
RV_CREDENTIAL_ENCRYPTION_KEYS=key-1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RV_ACTIVE_CREDENTIAL_KEY_ID=key-1

# ------------------------------------------------------------------------------
# 4. Job Engine & Artifact Storage (RV-DEC-P2-0005, RV-DEC-P2-0006)
# ------------------------------------------------------------------------------
RV_WORKER_QUEUES=default
RV_WORKER_CONCURRENCY=2
RV_JOB_POLL_INTERVAL_MS=1000
RV_JOB_LEASE_SECONDS=300
RV_JOB_MAX_ATTEMPTS=8
RV_ARTIFACT_STORAGE_BACKEND=filesystem
RV_ARTIFACT_STORAGE_PATH=/tmp/rekanvault_artifacts
RV_MAX_SOURCE_FILE_BYTES=52428800

# ------------------------------------------------------------------------------
# 5. Next.js Web Frontend (Public Browser Accessible)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_REKANVAULT_API_URL=http://localhost:9002

# ------------------------------------------------------------------------------
# 6. Qdrant Cloud Vector Index (Phase 4) — fill from Qdrant dashboard
# ------------------------------------------------------------------------------
RV_QDRANT_URL=
RV_QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 7. Source Connectors (Phase 3)
# ------------------------------------------------------------------------------
# Google Drive OAuth (RV-DEC-P3-0001)
RV_GOOGLE_CLIENT_ID=
RV_GOOGLE_CLIENT_SECRET=
RV_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:9002/api/v1/auth/callback/google
RV_GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly
RV_GOOGLE_API_TIMEOUT_SECONDS=30
RV_GOOGLE_PILOT_REFRESH_TOKEN=
RV_GOOGLE_FOLDER_ID=

# Notion Internal Integration (RV-DEC-P3-0002)
RV_NOTION_API_VERSION=2026-03-11
RV_NOTION_TOKEN=
RV_NOTION_API_TIMEOUT_SECONDS=30
RV_NOTION_WEBHOOK_VERIFICATION_TOKEN=
RV_NOTION_PAGE_ID=
